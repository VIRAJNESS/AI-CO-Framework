# =============================================================================
# AI Coach Mastery — 12-Factor environment configuration
# Copy to .env (make env). Local defaults require ZERO external cloud keys.
# =============================================================================

# --- Provider selection (cloud-agnostic switches) ----------------------------
# STORAGE_PROVIDER: local | s3 | azure_blob | gcs
STORAGE_PROVIDER=local
# LLM_PROVIDER: mock | openai | anthropic | azure_openai | bedrock | vertex
LLM_PROVIDER=mock

# --- Database ----------------------------------------------------------------
POSTGRES_USER=aicoach
POSTGRES_PASSWORD=aicoach_local_dev
POSTGRES_DB=aicoach
# Used by core-api (JDBC) — compose network host is 'postgres'
DB_URL=jdbc:postgresql://postgres:5432/aicoach
# Used by ai-engine (SQLAlchemy)
AI_DB_URL=postgresql+psycopg://aicoach:aicoach_local_dev@postgres:5432/aicoach

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO locally; S3-compatible) ---------------------------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-coach-artifacts
# Local filesystem path used when STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/data/artifacts

# --- LLM provider keys (NOT required for mock) -------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AWS_REGION=
# GOOGLE_CLOUD_PROJECT=

# --- Service URLs (frontend -> backends) --------------------------------------
CORE_API_URL=http://localhost:8080
AI_ENGINE_URL=http://localhost:8000
